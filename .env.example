# Hospital Management System Environment Configuration (Example)
# Copy this file to .env and adjust variables as required

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=hospital_db
MYSQL_USER=hms_user
MYSQL_PASSWORD=change_this_user_password
MYSQL_PORT=3306

# Backend Configuration
PORT=5000
NODE_ENV=production
DB_HOST=mysql
DB_PORT=3306

# Frontend Configuration
FRONTEND_PORT=8080
BACKEND_HOST=backend
BACKEND_PORT=5000
